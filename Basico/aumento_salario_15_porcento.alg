algoritmo "AUMENTO"
var
   salario, aumento, valorAumento: real
inicio
      Escreva("Valor do seu salario: ")
      leia(salario)
      aumento <- salario * 0.15
      valorAumento <- salario + aumento
      
      escreva("O seu salario com 15% de aumento é: ", valorAumento)
fimalgoritmo