algoritmo "RADIANOS"
var
   absoluto: inteiro
   exponenciacao:  real
   raizquadrada:  real
   radianos: real
inicio
   absoluto <- Abs(-50)
   escreval(absoluto)
   exponenciacao <- Exp(9,5)
   escreval(exponenciacao)
   raizquadrada <- int(RaizQ(90))
   escreval(raizquadrada)
   
   radianos <- Sen(GraupRad(90))
   escreval(radianos)

fimalgoritmo