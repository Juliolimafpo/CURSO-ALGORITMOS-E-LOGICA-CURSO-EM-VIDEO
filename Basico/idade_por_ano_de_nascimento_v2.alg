algoritmo "RADIANOS"
var

   ano_atual, ano_nasc, idade: inteiro
   

inicio

      escreva("Digite o ano atual: ")
      leia(ano_atual)
      escreva("Qual o seu ano de nascimento? ")
      leia(ano_nasc)
      
      idade <- (ano_atual - ano_nasc)
      
      escreva("Sua idade é:", idade)
      


fimalgoritmo