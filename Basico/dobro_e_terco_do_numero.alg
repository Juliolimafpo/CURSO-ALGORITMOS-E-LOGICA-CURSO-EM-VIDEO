algoritmo "dobroTerca"
var
   numero, dobro, terca: real
inicio
      escreva("Digite um numero real: ")
      leia(numero)
      
      dobro <- numero * 2
      terca <- numero / 3
      
      escreva("O dobro de ", numero, " é", dobro)
      escreva("O terço de", numero, " é", terca)

fimalgoritmo